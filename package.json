{
	"name": "svelte-finder",
	"version": "0.2.0",
	"description": "A Finder-style file browser for Svelte 5: icons, list and columns views over any filesystem (in-memory, modern-monaco, just-bash).",
	"license": "MIT",
	"keywords": [
		"svelte",
		"svelte5",
		"file-browser",
		"file-explorer",
		"finder",
		"filesystem",
		"modern-monaco",
		"just-bash"
	],
	"homepage": "https://finder.mastermakrela.com",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mastermakrela/svelte-finder.git"
	},
	"bugs": {
		"url": "https://github.com/mastermakrela/svelte-finder/issues"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && bun run prepack",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"prepare": "svelte-kit sync || echo \"\"",
		"prepack": "bun run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "bun --bun vitest",
		"test": "bun --bun vitest --run"
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"sideEffects": [
		"**/*.css"
	],
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"peerDependencies": {
		"svelte": "^5.40.0"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^4.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^3.0.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.1",
		"@wterm/dom": "0.5.9",
		"@wterm/just-bash": "0.5.9",
		"@wterm/svelte": "0.5.9",
		"eslint": "^10.12.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.13.0",
		"just-bash": "^3.6.0",
		"modern-monaco": "^0.4.2",
		"modern-monaco-svelte": "^0.5.0",
		"phosphor-svelte": "^3.1.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"publint": "^0.3.25",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.71.0",
		"vite": "^8.3.2",
		"vitest": "^5.0.3"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
